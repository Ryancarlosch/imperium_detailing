$ErrorActionPreference = 'Stop'
Set-StrictMode -Version 2.0

$Root = Split-Path -Parent $MyInvocation.MyCommand.Path
Set-Location $Root

function Secao([string]$t) {
  Write-Host ''
  Write-Host ('=' * 72) -ForegroundColor DarkGray
  Write-Host $t -ForegroundColor Cyan
  Write-Host ('=' * 72) -ForegroundColor DarkGray
}

function Ok([string]$t) { Write-Host "[OK] $t" -ForegroundColor Green }

function Ler([string]$p) {
  if (-not (Test-Path $p)) { throw "Arquivo nao encontrado: $p" }
  return [IO.File]::ReadAllText($p)
}

function Gravar([string]$p,[string]$c) {
  $dir = Split-Path $p -Parent
  if ($dir -and -not (Test-Path $dir)) {
    New-Item -ItemType Directory -Path $dir -Force | Out-Null
  }
  [IO.File]::WriteAllText($p,$c,[Text.UTF8Encoding]::new($false))
}

function GravarB64([string]$p,[string]$b64) {
  $dir = Split-Path $p -Parent
  if ($dir -and -not (Test-Path $dir)) {
    New-Item -ItemType Directory -Path $dir -Force | Out-Null
  }
  [IO.File]::WriteAllBytes($p,[Convert]::FromBase64String($b64))
}

function Trocar([string]$p,[string]$old,[string]$new,[string]$marker) {
  $c = (Ler $p).Replace("`r`n","`n")
  $oldN = $old.Replace("`r`n","`n")
  $newN = $new.Replace("`r`n","`n")

  if ($c.Contains($marker)) {
    Ok "$marker ja aplicado"
    return
  }

  if (-not $c.Contains($oldN)) {
    throw "Trecho nao encontrado para $marker em $p"
  }

  $c = $c.Replace($oldN,$newN)
  Gravar $p $c
  Ok $marker
}

if (-not (Test-Path '.\pubspec.yaml')) {
  throw 'Execute na raiz do projeto Flutter.'
}

