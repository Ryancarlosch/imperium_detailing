'@ @'
  @override
  void initState() {
    super.initState();
    _carregar();
    _iniciarRealtime();
  }

  Future<void> _iniciarRealtime() async {
    // meu-ponto-realtime-v4
    try {
      final assinatura = await _realtimeService.ouvirColaborador(
        colaboradorLocalId: widget.colaboradorId,
        aoMudar: _agendarAtualizacaoRealtime,
      );

      if (!mounted) {
        await assinatura?.cancelar();
        return;
      }

      _realtimeSubscription = assinatura;
    } catch (_) {
      // Realtime é uma melhoria. Pull-to-refresh e sincronização local
      // continuam funcionando se o canal estiver indisponível.
    }
  }

  void _agendarAtualizacaoRealtime() {
    if (!mounted) return;

    _realtimeDebounce?.cancel();
    _realtimeDebounce = Timer(const Duration(milliseconds: 400), () {
      if (!mounted || _carregando || _batendo) return;
      _carregar();
    });
  }

  @override
  void dispose() {
    _realtimeDebounce?.cancel();

    final assinatura = _realtimeSubscription;
    if (assinatura != null) {
      unawaited(assinatura.cancelar());
    }

    super.dispose();
  }

  Future<void> _carregar() async {
