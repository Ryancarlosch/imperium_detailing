SubstituirObrigatorio $custos $inicioResumoAntigo $inicioResumoNovo `
    "Normalizacao automatica da carga horaria legada."

$conteudoCustos = Ler $custos
$oldMax = "COALESCE(MAX(horas_produtivas_mes), 0) AS horas_equipe_fallback"
if ($conteudoCustos.Contains($oldMax)) {
    $conteudoCustos = $conteudoCustos.Replace(
        $oldMax,
        "COALESCE(SUM(horas_produtivas_mes), 0) AS horas_equipe_fallback"
    )
    Gravar $custos $conteudoCustos
    Ok "Fallback de capacidade alterado de MAX para SUM em todos os calculos."
}
else {
    Ok "Fallback SUM ja estava aplicado."
}

$maoObraSqlAntigo = @'
        COALESCE(SUM(
          remuneracao_mensal + encargos_mensais + outros_custos_mensais
        ), 0) AS custo_mensal,
        COALESCE(SUM(horas_produtivas_mes), 0) AS horas_equipe_fallback
      FROM financeiro_colaboradores_custo
      WHERE ativo = 1
'@

$maoObraSqlNovo = @'
        COALESCE(SUM(
          remuneracao_mensal + encargos_mensais + outros_custos_mensais
        ), 0) AS custo_mensal,
        COALESCE(SUM(horas_produtivas_mes), 0) AS horas_equipe_fallback,
        COUNT(*) AS colaboradores_ativos,
        COALESCE(AVG(horas_produtivas_mes), 0) AS horas_por_pessoa
      FROM financeiro_colaboradores_custo
      WHERE ativo = 1
'@

$conteudoCustos = Ler $custos
if (-not $conteudoCustos.Contains("COUNT(*) AS colaboradores_ativos")) {
    $indice = $conteudoCustos.IndexOf($maoObraSqlAntigo)
    if ($indice -lt 0) {
        throw "Nao encontrei o SQL do resumo de mao de obra para atualizar."
    }
    $conteudoCustos = $conteudoCustos.Remove(
        $indice,
        $maoObraSqlAntigo.Length
    ).Insert(
        $indice,
        $maoObraSqlNovo
    )
    Gravar $custos $conteudoCustos
    Ok "Resumo da equipe agora informa pessoas ativas e horas por pessoa."
}
else {
    Ok "Resumo detalhado da equipe ja estava aplicado."
}

