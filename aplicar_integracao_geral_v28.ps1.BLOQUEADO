$ErrorActionPreference = 'Stop'
Set-StrictMode -Version 2.0

$Root = Split-Path -Parent $MyInvocation.MyCommand.Path
Set-Location $Root

function Secao([string]$texto) {
    Write-Host ""
    Write-Host ("=" * 72) -ForegroundColor DarkGray
    Write-Host $texto -ForegroundColor Cyan
    Write-Host ("=" * 72) -ForegroundColor DarkGray
}

function Ok([string]$texto) {
    Write-Host "[OK] $texto" -ForegroundColor Green
}

function Ler([string]$caminho) {
    if (-not (Test-Path $caminho)) {
        throw "Arquivo nao encontrado: $caminho"
    }
    return Get-Content -Path $caminho -Raw -Encoding UTF8
}

function Gravar([string]$caminho, [string]$conteudo) {
    Set-Content -Path $caminho -Value $conteudo -Encoding UTF8
}

function SubstituirObrigatorio(
    [string]$caminho,
    [string]$antigo,
    [string]$novo,
    [string]$descricao
) {
    $conteudo = Ler $caminho

    if ($conteudo.Contains($novo)) {
        Ok "$descricao ja estava aplicado."
        return
    }

    if (-not $conteudo.Contains($antigo)) {
        throw "Nao encontrei o trecho esperado para: $descricao"
    }

    $conteudo = $conteudo.Replace($antigo, $novo)
    Gravar $caminho $conteudo
    Ok $descricao
}

function SubstituirOpcional(
    [string]$caminho,
    [string]$antigo,
    [string]$novo,
    [string]$descricao
) {
    $conteudo = Ler $caminho
    if ($conteudo.Contains($antigo)) {
        $conteudo = $conteudo.Replace($antigo, $novo)
        Gravar $caminho $conteudo
        Ok $descricao
    }
}

Secao "IMPERIUM - INTEGRACAO GERAL DE CUSTOS, PONTO, PRECIFICACAO E PERMISSOES"

$custos = Join-Path $Root 'lib\repositories\custos_repository.dart'
$maoObra = Join-Path $Root 'lib\screens\mao_obra_custos_page.dart'
$precificacao = Join-Path $Root 'lib\repositories\precificacao_repository.dart'
$dashboard = Join-Path $Root 'lib\screens\dashboard_page.dart'
$relatorio = Join-Path $Root 'lib\screens\relatorios_financeiros_page.dart'
$relatorioCorrigido = Join-Path $Root 'lib\screens\relatorios_financeiros_page_corrigido.dart'
$teste = Join-Path $Root 'test\colaborador_custo_test.dart'

Secao "1/6 - RELATORIOS FINANCEIROS"

if (Test-Path $relatorioCorrigido) {
    if (-not (Test-Path $relatorio)) {
        throw "Tela oficial de relatorios nao encontrada."
    }

    $corrigido = Ler $relatorioCorrigido
    if ($corrigido -notmatch 'class\s+RelatoriosFinanceirosPage\s+extends\s+StatefulWidget') {
        throw "A tela _corrigido nao possui a classe esperada."
    }

    Get-ChildItem -Path (Join-Path $Root 'lib') -Recurse -File -Filter '*.dart' |
        ForEach-Object {
            if ($_.FullName -eq $relatorioCorrigido) {
                return
            }

            $c = Ler $_.FullName
            if ($c.Contains('relatorios_financeiros_page_corrigido.dart')) {
                $c = $c.Replace(
                    'relatorios_financeiros_page_corrigido.dart',
                    'relatorios_financeiros_page.dart'
                )
                Gravar $_.FullName $c
                Ok "Import de relatorio corrigido em $($_.Name)"
            }
        }

    Copy-Item $relatorioCorrigido $relatorio -Force
    Remove-Item $relatorioCorrigido -Force
    Ok "Tela de relatorios consolidada."
}
else {
    Ok "Nao ha duplicata temporaria de relatorios."
}

Secao "2/6 - CARGA HORARIA E CUSTO DA EQUIPE"

$blocoAntigo = @'
  Future<int> salvarColaborador(ColaboradorCusto colaborador) async {
    final nome = colaborador.nome.trim();
    if (nome.length < 2) {
      throw ArgumentError('Informe o nome do colaborador.');
    }
    if (colaborador.remuneracaoMensal < 0 ||
        colaborador.encargosMensais < 0 ||
        colaborador.outrosCustosMensais < 0) {
      throw ArgumentError('Os valores de custo não podem ser negativos.');
    }
    if (colaborador.horasProdutivasMes <= 0) {
      throw ArgumentError('Informe as horas produtivas mensais.');
    }

    final database = await _appDatabase.database;
    final agora = DateTime.now().toIso8601String();
    final mapa = colaborador.toMap(incluirId: false)
      ..['nome'] = nome
      ..['funcao'] = colaborador.funcao.trim()
      ..['atualizado_em'] = agora;

    if (colaborador.id == null) {
      mapa['criado_em'] = agora;
      return database.insert(
        'financeiro_colaboradores_custo',
        mapa,
        conflictAlgorithm: ConflictAlgorithm.abort,
      );
    }

    await database.update(
      'financeiro_colaboradores_custo',
      mapa,
      where: 'id = ?',
      whereArgs: [colaborador.id],
    );
    return colaborador.id!;
  }

  Future<void> arquivarColaborador(int id) async {
    final database = await _appDatabase.database;
    await database.update(
      'financeiro_colaboradores_custo',
      {'ativo': 0, 'atualizado_em': DateTime.now().toIso8601String()},
      where: 'id = ?',
      whereArgs: [id],
    );
  }

  Future<void> sincronizarHorasProdutivasEquipe(double horas) async {
    if (horas <= 0) {
      throw ArgumentError('Informe uma carga horária mensal maior que zero.');
    }

    final database = await _appDatabase.database;

    await database.update('financeiro_colaboradores_custo', {
      'horas_produtivas_mes': horas,
      'atualizado_em': DateTime.now().toIso8601String(),
    }, where: 'ativo = 1');
  }
'@

$blocoNovo = @'
  Future<int> salvarColaborador(ColaboradorCusto colaborador) async {
    final nome = colaborador.nome.trim();
    if (nome.length < 2) {
      throw ArgumentError('Informe o nome do colaborador.');
    }
    if (colaborador.remuneracaoMensal < 0 ||
        colaborador.encargosMensais < 0 ||
        colaborador.outrosCustosMensais < 0) {
      throw ArgumentError('Os valores de custo não podem ser negativos.');
    }
    if (colaborador.horasProdutivasMes <= 0) {
      throw ArgumentError('Informe as horas produtivas mensais.');
    }

    final database = await _appDatabase.database;
    final agora = DateTime.now().toIso8601String();
    final mapa = colaborador.toMap(incluirId: false)
      ..['nome'] = nome
      ..['funcao'] = colaborador.funcao.trim()
      ..['atualizado_em'] = agora;

    int colaboradorId;

    if (colaborador.id == null) {
      mapa['criado_em'] = agora;
      colaboradorId = await database.insert(
        'financeiro_colaboradores_custo',
        mapa,
        conflictAlgorithm: ConflictAlgorithm.abort,
      );
    } else {
      await database.update(
        'financeiro_colaboradores_custo',
        mapa,
        where: 'id = ?',
        whereArgs: [colaborador.id],
      );
      colaboradorId = colaborador.id!;
    }

    await _sincronizarCapacidadeEquipeComPrecificacao(database);
    return colaboradorId;
  }

  Future<void> arquivarColaborador(int id) async {
    final database = await _appDatabase.database;
    await database.update(
      'financeiro_colaboradores_custo',
      {'ativo': 0, 'atualizado_em': DateTime.now().toIso8601String()},
      where: 'id = ?',
      whereArgs: [id],
    );
    await _sincronizarCapacidadeEquipeComPrecificacao(database);
  }

  /// Define a carga mensal POR PESSOA.
  ///
  /// Exemplo: 3 pessoas x 220 h = 660 h de capacidade total da equipe.
  /// A capacidade total usada na precificação é sincronizada automaticamente.
  Future<void> sincronizarHorasProdutivasEquipe(double horasPorPessoa) async {
    if (horasPorPessoa <= 0) {
      throw ArgumentError('Informe uma carga horária mensal maior que zero.');
    }

    final database = await _appDatabase.database;

    await database.transaction((transaction) async {
      await transaction.update(
        'financeiro_colaboradores_custo',
        {
          'horas_produtivas_mes': horasPorPessoa,
          'atualizado_em': DateTime.now().toIso8601String(),
        },
        where: 'ativo = 1',
      );

      await _sincronizarCapacidadeEquipeComPrecificacao(transaction);
    });
  }

  /// Corrige bancos que usaram a semântica antiga, onde o total da equipe
  /// (por exemplo 660 h) podia ser gravado em CADA colaborador.
  Future<void> _normalizarCargaHorariaLegada(
    DatabaseExecutor executor,
  ) async {
    final tabela = await executor.rawQuery(
      '''
      SELECT name
      FROM sqlite_master
      WHERE type = 'table'
        AND name = 'financeiro_precificacao_config'
      LIMIT 1
      ''',
    );

    if (tabela.isEmpty) {
      return;
    }

    final equipe = await executor.rawQuery(
      '''
      SELECT
        COUNT(*) AS quantidade,
        COALESCE(MIN(horas_produtivas_mes), 0) AS menor_horas,
        COALESCE(MAX(horas_produtivas_mes), 0) AS maior_horas
      FROM financeiro_colaboradores_custo
      WHERE ativo = 1
      ''',
    );

    final quantidade = _int(equipe.first['quantidade']) ?? 0;
    if (quantidade < 2) {
      return;
    }

    final menor = _double(equipe.first['menor_horas']);
    final maior = _double(equipe.first['maior_horas']);

    if (menor <= 0 || (maior - menor).abs() > 0.01) {
      return;
    }

    final config = await executor.query(
      'financeiro_precificacao_config',
      columns: ['horas_produtivas_mes'],
      where: 'id = 1',
      limit: 1,
    );

    if (config.isEmpty) {
      return;
    }

    final totalConfigurado = _double(config.first['horas_produtivas_mes']);

    if ((totalConfigurado - maior).abs() > 0.01) {
      return;
    }

    final horasPorPessoa = totalConfigurado / quantidade;

    if (horasPorPessoa < 120 || horasPorPessoa > 260) {
      return;
    }

    await executor.update(
      'financeiro_colaboradores_custo',
      {
        'horas_produtivas_mes': horasPorPessoa,
        'atualizado_em': DateTime.now().toIso8601String(),
      },
      where: 'ativo = 1',
    );
  }

  Future<void> _sincronizarCapacidadeEquipeComPrecificacao(
    DatabaseExecutor executor,
  ) async {
    final tabela = await executor.rawQuery(
      '''
      SELECT name
      FROM sqlite_master
      WHERE type = 'table'
        AND name = 'financeiro_precificacao_config'
      LIMIT 1
      ''',
    );

    if (tabela.isEmpty) {
      return;
    }

    final equipe = await executor.rawQuery(
      '''
      SELECT COALESCE(SUM(horas_produtivas_mes), 0) AS horas_total
      FROM financeiro_colaboradores_custo
      WHERE ativo = 1
      ''',
    );

    final horasTotal = _double(equipe.first['horas_total']);
    if (horasTotal <= 0) {
      return;
    }

    await executor.update(
      'financeiro_precificacao_config',
      {
        'horas_produtivas_mes': horasTotal,
        'atualizado_em': DateTime.now().toIso8601String(),
      },
      where: 'id = 1',
    );
  }
'@

SubstituirObrigatorio $custos $blocoAntigo $blocoNovo `
    "Cadastro de colaboradores agora sincroniza capacidade real da equipe."

