SubstituirObrigatorio $maoObra `
    "label: const Text('Alterar carga horária da equipe')," `
    "label: const Text('Alterar carga horária por pessoa')," `
    "Botao de carga horaria renomeado."

$textoAntigo = @'
                    'Cadastre também seu próprio pró-labore quando sua mão de obra participa dos serviços. Isso evita considerar seu tempo como custo zero. Os custos de todos são somados, mas a carga horária da equipe entra apenas uma vez no cálculo.',
'@

$textoNovo = @'
                    'Cadastre também seu próprio pró-labore quando sua mão de obra participa dos serviços. Cada pessoa possui sua carga mensal individual. O sistema soma essas horas para formar a capacidade total da equipe e calcular o custo real por hora.',
'@

SubstituirObrigatorio $maoObra $textoAntigo $textoNovo `
    "Explicacao de custo/hora atualizada."

$conteudoMao = Ler $maoObra
$conteudoMao = $conteudoMao.Replace(
    'required this.horasEquipe,',
    'required this.horasPorPessoa,'
)
$conteudoMao = $conteudoMao.Replace(
    'final double horasEquipe;',
    'final double horasPorPessoa;'
)
$conteudoMao = $conteudoMao.Replace(
    "text: widget.horasEquipe.toStringAsFixed(1).replaceAll('.', ','),",
    "text: widget.horasPorPessoa.toStringAsFixed(1).replaceAll('.', ','),"
)
Gravar $maoObra $conteudoMao
Ok "Formulario individual usa horas por pessoa."

Secao "4/6 - PRECIFICACAO"

SubstituirObrigatorio $precificacao `
    "horas_produtivas_mes REAL NOT NULL DEFAULT 160," `
    "horas_produtivas_mes REAL NOT NULL DEFAULT 220," `
    "Nova configuracao de precificacao parte de 220 h."

SubstituirObrigatorio $precificacao `
    ") VALUES (1, 160, 3, 35, 20, 10, ?)" `
    ") VALUES (1, 220, 3, 35, 20, 10, ?)" `
    "Registro inicial de precificacao atualizado para 220 h."

SubstituirObrigatorio $precificacao `
    "_double(item['horas_produtivas_mes'], 160)" `
    "_double(item['horas_produtivas_mes'], 220)" `
    "Fallback da precificacao atualizado para 220 h."

Secao "5/6 - LOGIN E PERMISSOES"

$conteudoDashboard = Ler $dashboard

$oldAcesso = @'
  Future<void> _abrirPonto() async {
    if (!_validarAcesso('funcionarios')) return;

    await _abrirPagina(const PontoFuncionariosPage());
  }
'@

$newAcesso = @'
  Future<void> _abrirPonto() async {
    if (!_validarAcesso('ponto')) return;

    await _abrirPagina(const PontoFuncionariosPage());
  }
'@

if ($conteudoDashboard.Contains($oldAcesso)) {
    $conteudoDashboard = $conteudoDashboard.Replace($oldAcesso, $newAcesso)
    Ok "Acesso ao Ponto usa a permissao 'ponto'."
}
elseif ($conteudoDashboard.Contains("if (!_validarAcesso('ponto')) return;")) {
    Ok "Permissao especifica do Ponto ja estava aplicada."
}
else {
    throw "Nao encontrei o metodo _abrirPonto esperado."
}

if ($conteudoDashboard.Contains("if (_pode('funcionarios')) ...[")) {
    $conteudoDashboard = $conteudoDashboard.Replace(
        "if (_pode('funcionarios')) ...[",
        "if (_pode('ponto')) ...["
    )
    Ok "Card de Ponto respeita a permissao especifica."
}
elseif ($conteudoDashboard.Contains("if (_pode('ponto')) ...[")) {
    Ok "Visibilidade do card de Ponto ja estava correta."
}
else {
    throw "Nao encontrei a condicao do card de Ponto."
}

Gravar $dashboard $conteudoDashboard

Secao "6/6 - TESTE DE REGRESSAO"

if (-not (Test-Path (Split-Path -Parent $teste))) {
    New-Item -ItemType Directory -Path (Split-Path -Parent $teste) -Force | Out-Null
}

if (-not (Test-Path $teste)) {
    $testeConteudo = @'
import 'package:flutter_test/flutter_test.dart';
import 'package:imperium_detailing/models/colaborador_custo.dart';

void main() {
  test('custo hora usa a carga mensal individual do colaborador', () {
    const colaborador = ColaboradorCusto(
      nome: 'Funcionario',
      remuneracaoMensal: 2200,
      encargosMensais: 0,
      outrosCustosMensais: 0,
      horasProdutivasMes: 220,
      criadoEm: '2026-01-01',
      atualizadoEm: '2026-01-01',
    );

    expect(colaborador.custoHoraProdutiva, closeTo(10, 0.000001));
  });

  test('tres pessoas de 220h representam 660h de capacidade', () {
    const horasPorPessoa = 220.0;
    const pessoas = 3;

    expect(horasPorPessoa * pessoas, 660);
  });
}
'@
    Gravar $teste $testeConteudo
    Ok "Teste colaborador_custo_test.dart criado."
}
else {
    Ok "Teste colaborador_custo_test.dart ja existe."
}

Secao "ATUALIZACAO APLICADA"

Write-Host "Principais efeitos:" -ForegroundColor White
Write-Host " - 220 h agora significa 220 h POR PESSOA." -ForegroundColor White
Write-Host " - 3 pessoas de 220 h geram automaticamente 660 h de capacidade." -ForegroundColor White
Write-Host " - Corrige o caso legado em que 660 h podia estar gravado em cada pessoa." -ForegroundColor White
Write-Host " - Precificacao acompanha automaticamente entrada/saida de colaboradores." -ForegroundColor White
Write-Host " - Ponto e folha estimada passam a usar custo/hora individual coerente." -ForegroundColor White
Write-Host " - Permissao do modulo Ponto no Dashboard foi corrigida." -ForegroundColor White
Write-Host " - Relatorios Financeiros duplicados sao consolidados, se ainda existirem." -ForegroundColor White
Write-Host ""
Write-Host "O imperium.ps1 agora pode formatar, analisar, testar e gerar o APK." -ForegroundColor Cyan
Write-Host ""
